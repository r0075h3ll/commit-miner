OPENROUTER_API_KEY=

# Optional. Overridable with --model too. Defaults to an open-weight model.
# Open-weight: meta-llama/llama-3.3-70b-instruct (default), meta-llama/llama-4-scout,
#   meta-llama/llama-4-maverick, qwen/qwen-2.5-72b-instruct, qwen/qwen3-30b-a3b,
#   deepseek/deepseek-chat-v3.1, mistralai/mistral-small-3.2-24b-instruct
# Low-cost GPT: openai/gpt-4o-mini, openai/gpt-4.1-mini, openai/gpt-4.1-nano,
#   openai/gpt-5-mini, openai/gpt-5-nano
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
